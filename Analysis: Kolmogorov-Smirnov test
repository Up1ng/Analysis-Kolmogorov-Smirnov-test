import numpy as np
import pandas as pd
from scipy import stats
import matplotlib.pyplot as plt


def load_data_from_csv(filename):
    """
    Загружает данные из CSV файла для последующего статистического анализа.

    Parameters
    ----------
    filename : str
        Путь к CSV файлу с данными. Файл должен содержать как минимум 2 столбца 
        с числовыми данными для сравнения.

    Returns
    -------
    pandas.DataFrame
        DataFrame с загруженными данными. Если файл не найден, создается 
        демонстрационный набор данных.

    Raises
    ------
    FileNotFoundError
        Если файл не существует и не удается создать демонстрационный файл.

    Examples
    --------
    >>> df = load_data_from_csv('data.csv')
    >>> print(df.shape)
    (1000, 3)
    """
    try:
        df = pd.read_csv(filename)
        print(f"Файл '{filename}' успешно загружен")
        print(f"Столбцы в файле: {list(df.columns)}")
        print(f"Размер данных: {df.shape}")
        print(f"\nПервые 5 строк:")
        print(df.head())
        return df
    except FileNotFoundError:
        print(f"Ошибка: Файл '{filename}' не найден!")
        print("Создаю демонстрационный CSV файл...")
        return create_demo_csv()


def create_demo_csv():
    """
    Создает демонстрационный CSV файл с синтетическими данными для тестирования.

    Генерирует три набора данных:
    - normal_sample: данные из нормального распределения (μ=0, σ=1)
    - uniform_sample: данные из равномерного распределения (min=-3, max=3)  
    - normal_sample2: данные из нормального распределения (μ=0, σ=1)

    Returns
    -------
    pandas.DataFrame
        DataFrame с сгенерированными демонстрационными данными.

    Notes
    -----
    Используется фиксированный random seed (42) для воспроизводимости результатов.
    Размер каждой выборки - 1000 наблюдений.
    """
    np.random.seed(42)

    # Генерируем демонстрационные данные
    data = {
        'normal_sample': np.random.normal(loc=0, scale=1, size=1000),
        'uniform_sample': np.random.uniform(low=-3, high=3, size=1000),
        'normal_sample2': np.random.normal(loc=0, scale=1, size=1000)
    }

    df = pd.DataFrame(data)
    df.to_csv('sample_data.csv', index=False)
    print("Создан файл 'sample_data.csv' с демонстрационными данными")
    print(f"Столбцы: {list(df.columns)}")
    return df


def perform_ks_test(data1, data2, name1, name2):
    """
    Выполняет двухвыборочный тест Колмогорова-Смирнова для сравнения распределений.

    Parameters
    ----------
    data1 : array-like
        Первая выборка данных (может быть pandas.Series, numpy.array или list)
    data2 : array-like  
        Вторая выборка данных для сравнения
    name1 : str
        Название первой выборки (для вывода результатов)
    name2 : str
        Название второй выборки (для вывода результатов)

    Returns
    -------
    tuple
        (statistic, p_value) - статистика теста и p-value

    Notes
    -----
    Нулевая гипотеза (H0): обе выборки происходят из одного распределения.
    Альтернативная гипотеза (H1): выборки происходят из разных распределений.
    Уровень значимости α = 0.05.

    Examples
    --------
    >>> stat, pval = perform_ks_test(sample1, sample2, "Группа А", "Группа Б")
    >>> print(f"P-value: {pval:.4f}")
    """
    # Удаляем пропущенные значения
    data1_clean = data1.dropna() if hasattr(data1, 'dropna') else pd.Series(data1).dropna()
    data2_clean = data2.dropna() if hasattr(data2, 'dropna') else pd.Series(data2).dropna()

    print(f"\n--- Сравнение: '{name1}' vs '{name2}' ---")
    print(f"Размер выборки {name1}: {len(data1_clean)}")
    print(f"Размер выборки {name2}: {len(data2_clean)}")

    # Проверяем, что есть достаточное количество данных
    if len(data1_clean) < 10 or len(data2_clean) < 10:
        print("Предупреждение: Маленький размер выборки для надежного теста")

    # Выполняем тест Колмогорова-Смирнова
    statistic, p_value = stats.ks_2samp(data1_clean, data2_clean)

    # Выводим результаты
    print(f"K-S статистика: {statistic:.4f}")
    print(f"P-value: {p_value:.6f}")

    # Интерпретация результатов
    alpha = 0.05
    if p_value < alpha:
        print("ВЫВОД: Выборки происходят из РАЗНЫХ распределений")
        print(f"   (p-value < {alpha} - отвергаем нулевую гипотезу)")
    else:
        print("ВЫВОД: Нет оснований утверждать, что выборки из разных распределений")
        print(f"   (p-value >= {alpha} - не отвергаем нулевую гипотезу)")

    return statistic, p_value


def visualize_distributions(df, columns):
    """
    Создает визуализации для сравнения распределений выбранных столбцов.

    Parameters
    ----------
    df : pandas.DataFrame
        DataFrame с данными для визуализации
    columns : list
        Список названий столбцов для анализа

    Returns
    -------
    None
        Функция создает графики но не возвращает значений

    Notes
    -----
    Создает три типа визуализаций:
    1. Гистограммы распределений
    2. Box plots для сравнения квантилей
    3. Эмпирические функции распределения (ECDF)

    Все графики отображаются в одном окне с помощью matplotlib.
    """
    plt.figure(figsize=(15, 5))

    # Гистограммы
    plt.subplot(1, 3, 1)
    for col in columns:
        plt.hist(df[col].dropna(), bins=30, alpha=0.7, label=col)
    plt.title('Гистограммы распределений')
    plt.xlabel('Значения')
    plt.ylabel('Частота')
    plt.legend()

    # Box plots
    plt.subplot(1, 3, 2)
    data_to_plot = [df[col].dropna() for col in columns]
    plt.boxplot(data_to_plot, labels=columns)
    plt.title('Box plot сравнение')
    plt.ylabel('Значения')

    # Эмпирические функции распределения
    plt.subplot(1, 3, 3)
    for col in columns:
        data_clean = df[col].dropna()
        sorted_data = np.sort(data_clean)
        y = np.arange(1, len(sorted_data) + 1) / len(sorted_data)
        plt.plot(sorted_data, y, label=col, linewidth=2)
    plt.title('Эмпирические функции распределения')
    plt.xlabel('Значения')
    plt.ylabel('Вероятность')
    plt.legend()

    plt.tight_layout()
    plt.show()

    # Вывод описательной статистики
    print(f"\n{'=' * 60}")
    print("ОПИСАТЕЛЬНАЯ СТАТИСТИКА:")
    print(df[columns].describe())


def main():
    """
    Основная функция программы для проведения анализа Колмогорова-Смирнова.

    Выполняет полный цикл анализа:
    1. Загрузка данных из CSV файла
    2. Автоматический выбор столбцов для анализа
    3. Проведение теста Колмогорова-Смирнова
    4. Визуализация результатов
    5. Вывод статистической сводки

    Workflow
    --------
    - Загружает данные из 'sample_data.csv' (или создает демо-файл)
    - Автоматически выбирает первые два числовых столбца
    - Проводит статистический тест
    - Создает сравнительные визуализации
    - Выводит интерпретацию результатов

    Examples
    --------
    >>> main()
    === ТЕСТ КОЛМОГОРОВА-СМИРНОВА С ИМПОРТОМ ИЗ CSV ===
    Файл 'sample_data.csv' успешно загружен
    ...
    """
    print("=== ТЕСТ КОЛМОГОРОВА-СМИРНОВА С ИМПОРТОМ ИЗ CSV ===\n")

    # 1. Загрузка данных из CSV
    filename = 'sample_data.csv'  # Можно изменить на имя вашего файла
    df = load_data_from_csv(filename)

    # 2. Выбор столбцов для анализа
    columns = list(df.columns)
    print(f"\nДоступные столбцы для анализа: {columns}")

    # Автоматический выбор первых двух числовых столбцов
    if len(columns) >= 2:
        col1, col2 = columns[0], columns[1]
        print(f"Автоматически выбраны столбцы: '{col1}' и '{col2}'")

        # 3. Выполнение теста
        statistic, p_value = perform_ks_test(df[col1], df[col2], col1, col2)

        # 4. Дополнительные сравнения если есть больше столбцов
        if len(columns) > 2:
            print(f"\n{'=' * 60}")
            print("ДОПОЛНИТЕЛЬНЫЕ СРАВНЕНИЯ:")
            for i in range(min(3, len(columns))):  # Сравним первые 3 столбца между собой
                for j in range(i + 1, min(3, len(columns))):
                    if i != j:
                        perform_ks_test(df[columns[i]], df[columns[j]], columns[i], columns[j])

        # 5. Визуализация распределений
        visualize_distributions(df, [col1, col2])

    else:
        print("Ошибка: В файле должно быть как минимум 2 столбца с данными")


if __name__ == "__main__":
    main()
